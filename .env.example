# ---- Mode ----
# true  = use bundled mock analysis data, no external services required
# false = perform a real clone + Tree-sitter parse + embeddings + Ollama generation
MOCK_MODE=true

# ---- Server ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/repo-intel
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/repo-intel
MONGODB_URI=mongodb://127.0.0.1:27017/repo-intel

# ---- Ollama (local LLM, no API key) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Repository analysis limits ----
MAX_REPO_SIZE_MB=300
MAX_FILES_TO_PARSE=2000
CLONE_TIMEOUT_MS=120000
